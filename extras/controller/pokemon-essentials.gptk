# R36S / ArkOS Pokemon Essentials controller mapping
# Verified during Pokemon Rejuvenation testing.
# Intended for compatible mkxp-z builds of Pokemon Reborn, Rejuvenation and Desolation.

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

a = c
b = x
x = z
y = a

start = enter

l1 = leftshift
r1 = rightshift
l2 = home
r2 = end

deadzone_x = 2000
deadzone_y = 2000
deadzone_triggers = 3000
